.page {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  background: var(--bg);
}

/* ---------- 倒计时横幅 ---------- */
.cd-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #1b2540, #171d27);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.cd-bar.urgent {
  background: linear-gradient(135deg, #3a1b2a, #171d27);
  border-color: rgba(242, 100, 122, .5);
  animation: pulse 1.6s ease-in-out infinite;
}

.cd-bar.soon {
  background: linear-gradient(135deg, #3a301b, #171d27);
  border-color: rgba(245, 177, 76, .45);
}

.cd-bar.now {
  background: linear-gradient(135deg, #14322a, #171d27);
  border-color: rgba(62, 207, 142, .45);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .82; }
}

.cd-label { font-size: 22rpx; color: var(--text-dim); }
.cd-main { display: flex; align-items: baseline; margin-top: 4rpx; }
.cd-days { font-size: 44rpx; font-weight: 800; color: var(--text); line-height: 1; }
.cd-unit { font-size: 22rpx; color: var(--text-dim); margin-left: 6rpx; }
.cd-right { text-align: right; }
.cd-time { font-size: 30rpx; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
.cd-date { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }

/* ---------- 今日统计条 ---------- */
.side {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  padding: 0 8rpx 16rpx;
}

.side b { color: var(--text); font-weight: 700; }

/* ---------- 进度与 chips ---------- */
.progress { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }

.progress .bar {
  flex: 1;
  height: 10rpx;
  background: var(--panel-2);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress .fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  border-radius: 999rpx;
  transition: width .25s ease;
}

.progress .counter { font-size: 22rpx; color: var(--text-dim); font-variant-numeric: tabular-nums; }

.chips { display: flex; gap: 12rpx; margin-bottom: 20rpx; flex-wrap: wrap; }

.chip {
  font-size: 20rpx;
  color: var(--text-dim);
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.chip.on { color: var(--accent); border-color: rgba(91, 140, 255, .5); }

/* ---------- 闪卡 ---------- */
.card {
  position: relative;
  height: 620rpx;
  perspective: 1200rpx;
  margin-bottom: 24rpx;
}

.face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transition: transform .42s ease;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .32);
  display: flex;
  flex-direction: column;
}

.face.front { transform: rotateY(0deg); }
.face.back { transform: rotateY(180deg); }
.card.flipped .face.front { transform: rotateY(-180deg); }
.card.flipped .face.back { transform: rotateY(0deg); }

.f-top { display: flex; justify-content: space-between; }

.f-cat, .f-lv {
  font-size: 20rpx;
  color: var(--accent);
  background: rgba(91, 140, 255, .12);
  border: 1rpx solid rgba(91, 140, 255, .35);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.f-lv { color: var(--text-dim); background: var(--panel-2); border-color: var(--line); }

.f-mid { flex: 1; display: flex; flex-direction: column; justify-content: center; }

.f-term { font-size: 52rpx; font-weight: 800; color: var(--text); line-height: 1.25; }
.f-en { font-size: 26rpx; color: var(--text-dim); margin-top: 16rpx; }
.f-ja { font-size: 26rpx; color: var(--text-dim); margin-top: 8rpx; }
.f-hint { font-size: 20rpx; color: var(--text-dim); opacity: .7; text-align: center; }

.b-head { padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }
.b-term { font-size: 32rpx; font-weight: 700; color: var(--text); }
.b-ja { font-size: 22rpx; color: var(--text-dim); margin-left: 12rpx; }

.b-body { flex: 1; margin-top: 16rpx; }

.b-def { font-size: 28rpx; color: var(--text); line-height: 1.75; }

.b-sec {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  margin: 20rpx 0 10rpx;
}

.b-points { padding-left: 6rpx; }

.bp {
  font-size: 25rpx;
  color: var(--text);
  line-height: 1.65;
  padding-left: 20rpx;
  position: relative;
  margin-bottom: 4rpx;
}

.bp::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
}

.b-eg { font-size: 25rpx; color: var(--text-dim); line-height: 1.7; }

.b-rel { display: flex; flex-wrap: wrap; gap: 12rpx; }

.tag {
  font-size: 21rpx;
  color: var(--accent);
  background: rgba(91, 140, 255, .12);
  border: 1rpx solid rgba(91, 140, 255, .35);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---------- 评分条 ---------- */
.rate-bar { display: flex; gap: 16rpx; }

.rate-bar.disabled { opacity: .35; pointer-events: none; }

.rate {
  flex: 1;
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 22rpx 0;
  border: 1rpx solid var(--line);
  background: var(--panel);
  color: var(--text);
  line-height: 1.4;
}

.rate.r0 { color: var(--bad); border-color: rgba(242, 100, 122, .4); }
.rate.r1 { color: var(--warn); border-color: rgba(245, 177, 76, .4); }
.rate.r2 { color: var(--good); border-color: rgba(62, 207, 142, .4); }

.rate-hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-dim);
  opacity: .7;
  margin-top: 14rpx;
}

/* ---------- 空态 / 总结 ---------- */
.empty-title, .sum-title { font-size: 34rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.empty .muted { line-height: 1.7; }

.sum-grid { display: flex; gap: 16rpx; margin: 24rpx 0 8rpx; }

.sum-cell {
  flex: 1;
  background: var(--panel-2);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx 0;
  text-align: center;
}

.sum-cell b { display: block; font-size: 34rpx; color: var(--text); font-weight: 800; }
.sum-cell span { font-size: 20rpx; color: var(--text-dim); }

.sum-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.sum-actions .btn { flex: 1; }
