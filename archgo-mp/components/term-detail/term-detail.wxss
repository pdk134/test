.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .55);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity .22s ease;
  z-index: 100;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  background: var(--panel);
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1rpx solid var(--line);
  transform: translateY(100%);
  transition: transform .22s ease;
  display: flex;
  flex-direction: column;
}

.modal.show .sheet {
  transform: translateY(0);
}

.sheet-body {
  padding: 32rpx 32rpx 48rpx;
  max-height: 82vh;
}

.d-head {
  position: relative;
  padding-right: 120rpx;
}

.d-term {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.d-sub {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 8rpx;
  line-height: 1.5;
}

.d-badge {
  position: absolute;
  right: 0;
  top: 4rpx;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
  color: var(--text-dim);
  border: 1rpx solid var(--line);
}

.d-badge.mastered { color: var(--good); border-color: var(--good); }
.d-badge.learning { color: var(--warn); border-color: var(--warn); }

.d-sec {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
  margin: 28rpx 0 12rpx;
}

.d-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
}

.d-text.muted { color: var(--text-dim); font-size: 24rpx; }

.d-points { padding-left: 8rpx; }

.dp {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
  padding-left: 20rpx;
  position: relative;
  margin-bottom: 6rpx;
}

.dp::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
}

.d-rel { display: flex; flex-wrap: wrap; gap: 12rpx; }

.tag {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(91, 140, 255, .12);
  border: 1rpx solid rgba(91, 140, 255, .35);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.d-actions {
  margin-top: 36rpx;
  display: flex;
  justify-content: center;
}

.d-actions .btn { min-width: 240rpx; }
