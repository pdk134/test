<view class="page">
  <view class="title">我的打卡记录</view>

  <view class="record-item" wx:for="{{checkins}}" wx:key="id">
    <view class="record-main">
      <view class="record-mall">{{item.mall_name}}</view>
      <view class="record-address">{{item.mall_address}}</view>
      <view class="record-time">{{item.timeText}}</view>
    </view>
    <view class="record-dist">{{item.distanceText}}</view>
  </view>

  <view wx:if="{{checkins.length === 0}}" class="empty">还没有打卡记录，快去打卡吧</view>
</view>
