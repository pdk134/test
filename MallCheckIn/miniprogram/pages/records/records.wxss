.title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 16rpx 8rpx 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.record-main {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.record-mall {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.record-address {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-time {
  font-size: 24rpx;
  color: #aaa;
}

.record-dist {
  font-size: 28rpx;
  color: #4F7CFF;
  font-weight: 600;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}
